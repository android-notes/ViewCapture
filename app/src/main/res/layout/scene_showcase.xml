<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CaptureTarget">
    <io.github.viewcapture.demo.sample.VideoTextureSampleView
        android:id="@+id/video_sample"
        android:layout_width="match_parent"
        android:layout_height="160dp" />
    <io.github.viewcapture.demo.sample.OutlineSampleView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:clipChildren="false" />
    <io.github.viewcapture.demo.sample.RenderEffectSampleView
        android:id="@+id/effect_sample"
        android:layout_width="match_parent"
        android:layout_height="160dp" />
</LinearLayout>
